{
  "name": "excavelo",
  "version": "1.4.7",
  "description": "Transform raw memos into structured notes using Claude. Obsidian community plugin.",
  "main": "main.js",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "generate:starter": "node scripts/generate-starter-templates.mjs",
    "predev": "node scripts/generate-starter-templates.mjs",
    "dev": "node esbuild.config.mjs",
    "prebuild": "node scripts/generate-starter-templates.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src --ext .ts",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "claude",
    "anthropic",
    "memo",
    "meeting-minutes",
    "llm"
  ],
  "author": "bibleCode21",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@eslint/json": "0.14.0",
    "@types/node": "^20.11.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "eslint-plugin-obsidianmd": "0.4.1",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.64.0"
  }
}
