{
  "name": "excavelo",
  "version": "1.3.3",
  "description": "Transform raw memos into structured notes using Claude. Obsidian community plugin.",
  "main": "main.js",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "generate:starter": "node scripts/generate-starter-templates.mjs",
    "predev": "node scripts/generate-starter-templates.mjs",
    "dev": "node esbuild.config.mjs",
    "prebuild": "node scripts/generate-starter-templates.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src --ext .ts",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "claude",
    "anthropic",
    "memo",
    "meeting-minutes",
    "llm"
  ],
  "author": "bibleCode21",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "openai": "^4.60.0"
  }
}
